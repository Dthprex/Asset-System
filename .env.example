# cosmetics.lk IT Infrastructure & Fleet Custody Portal
# Environment Configuration

NODE_ENV=production
PORT=3000
HOSTNAME="0.0.0.0"

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Max Size (in bytes, default 15MB)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=15728640

# Timezone
TZ=Asia/Colombo

# Supabase PostgreSQL & Storage Configuration (Optional - falls back to local JSON if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

